--==================== ROLES ====================--
local function nameHas(s, k) return s:lower():find(k, 1, true) ~= nil end

local function getRole(plr)
	if plr == LP then return "You" end
	local ok, attr = pcall(function() return plr:GetAttribute("Role") end)
	if ok and typeof(attr) == "string" and #attr > 0 then
		if nameHas(attr, "murder") or nameHas(attr, "asesino") then return "Murderer" end
		if nameHas(attr, "sheriff") then return "Sheriff" end
		if nameHas(attr, "innocent") then return "Innocent" end
	end
	local rf = RS:FindFirstChild("Roles")
	if rf then
		local v = rf:FindFirstChild(plr.Name)
		if v and typeof(v.Value) == "string" then
			if nameHas(v.Value, "murder") then return "Murderer" end
			if nameHas(v.Value, "sheriff") then return "Sheriff" end
		end
	end
	local char = plr.Character
	if char then
		for _, c in ipairs(char:GetChildren()) do
			if c:IsA("Tool") then
				if nameHas(c.Name, "knife") or nameHas(c.Name, "cuchillo") then return "Murderer" end
				if nameHas(c.Name, "gun") or nameHas(c.Name, "pistol") then return "Sheriff" end
			end
		end
	end
	local bp = plr:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then
				if nameHas(t.Name, "knife") or nameHas(t.Name, "cuchillo") then return "Murderer" end
				if nameHas(t.Name, "gun") or nameHas(t.Name, "pistol") then return "Sheriff" end
			end
		end
	end
	return "Innocent"
end

local function roleColor(r)
	if r == "Murderer" then return Color3.fromRGB(255, 70, 70) end
	if r == "Sheriff" then return Color3.fromRGB(70, 160, 255) end
	return Color3.fromRGB(120, 255, 140)
end

