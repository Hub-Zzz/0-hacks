end)

--==================== FULLBRIGHT ====================--
local oldLight
local function setFullbright(on)
	if on then
		oldLight = { Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.FogEnd }
		Lighting.Brightness = 3
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.FogEnd = 100000
	elseif oldLight then
		Lighting.Brightness = oldLight[1]
		Lighting.Ambient = oldLight[2]
		Lighting.OutdoorAmbient = oldLight[3]
		Lighting.FogEnd = oldLight[4]
	end
end

--==================== AUTOSHOOT ====================--
local aimTarget

local function getGun()
	local char = LP.Character
	if not char then return nil end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and nameHas(t.Name, "gun") then return t end
	end
	local bp = LP:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and nameHas(t.Name, "gun") then return t end
		end
	end
	return nil
end

local function findMurderer()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local best, bestD
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		local hum  = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and getRole(p) == "Murderer" then
			local d = (hrp.Position - cam.CFrame.Position).Magnitude
			if d <= cfg.range and (not bestD or d < bestD) then best, bestD = p, d end
		end
	end
	return best
end

local function hasLOS(char)
	local cam = workspace.CurrentCamera
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not cam or not hrp then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, LP.Character }
	local res = workspace:Raycast(cam.CFrame.Position, hrp.Position - cam.CFrame.Position, params)
	return res == nil
end

local aimConn = RunService:BindToRenderStep("VeniceAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not cfg.autoShoot or not aimTarget then return end
	local char = aimTarget.Character
	local tgt  = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	local cam  = workspace.CurrentCamera
	if not tgt or not cam then return end
	cam.CFrame = CFrame.lookAt(cam.CFrame.Position, tgt.Position)
end)

task.spawn(function()
	while true do
		if cfg.autoShoot then
			pcall(function()
				UIS.MouseIconEnabled = false
				UIS.MouseBehavior = Enum.MouseBehavior.LockCenter

				local char = LP.Character
				local hum  = char and char:FindFirstChildOfClass("Humanoid")
				local gun  = getGun()
				local mur  = findMurderer()

				if gun and mur and char and hum and hum.Health > 0 then
					if gun.Parent ~= char then
						hum:EquipTool(gun)
						task.wait(0.13)
					end
					if gun.Parent == char then
						aimTarget = mur
						if hasLOS(mur.Character) then
							gun:Activate()
							task.wait(0.05)
						end
					end
				else
					aimTarget = nil
				end
			end)
		else
			aimTarget = nil
			UIS.MouseIconEnabled = true
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		task.wait(cfg.delay)
	end
end)

