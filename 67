--==================== ESP ====================--
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP"
espFolder.Parent = gui

local function clearESP()
	for _, c in ipairs(espFolder:GetChildren()) do c:Destroy() end
end

local function buildESP(plr)
	local char = plr.Character
	local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if not head then return end
	local r   = getRole(plr)
	local col = roleColor(r)

	local hl = espFolder:FindFirstChild(plr.Name .. "_HL")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = plr.Name .. "_HL"
		hl.FillTransparency = 0.65
		hl.OutlineSize = 1.5
		hl.Parent = espFolder
	end
	hl.Adornee = char
	hl.FillColor = col
	hl.OutlineColor = col

	local bb = espFolder:FindFirstChild(plr.Name .. "_BB")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = plr.Name .. "_BB"
		bb.Size = UDim2.fromOffset(180, 36)
		bb.StudsOffset = Vector3.new(0, 2.6, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 800
		bb.Parent = espFolder
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 12
		lbl.TextStrokeTransparency = 0.4
		lbl.Parent = bb
	end
	bb.Adornee = head
	local lbl = bb:FindFirstChildOfClass("TextLabel")
	if lbl then
		lbl.TextColor3 = col
		lbl.Text = (cfg.names and (plr.Name .. "  ") or "") .. "[" .. r .. "]"
	end
end

task.spawn(function()
	while true do
		if cfg.esp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LP and p.Character then buildESP(p) end
			end
		end
		task.wait(0.35)
	end
end)

